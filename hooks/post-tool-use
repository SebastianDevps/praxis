#!/usr/bin/env bash
# PostToolUse hook — writes the approval record (specs/hook-owned-approval, ADR-001), the
# escalation record, and consumes the person's command token (specs/factory-cycle).
#
# The floor's approval stop is the host's `ask` on the first source edit of a specified
# change. The one thing the model cannot do is answer its own permission prompt, so the
# durable trace of that answer is written HERE, after the edit ran: `.praxis/approved/<change>`.
# `pre-tool-use` gates on that marker — not on `stage:`, which the model owns and, measured in
# evals/floor, advances by itself (3/3 unattended runs) once the ask is refused.
#
# Written when, and only when: the edit targeted a source-side path, the mode is full (in fast
# nothing asks, so an edit there is not an approval of anything), the active change has its
# spec (`spec.md`, or the legacy `design.md`), and no marker exists yet. Empty file; its
# existence is the record. An edit inside the builder's worktree (`<root>/.praxis/worktrees/
# <name>/`) is judged by that checkout, the same re-rooting pre-tool-use applies.
#
# The second record rides on the same event. When the edit wrote `specs/<change>/decision.md`
# for the ACTIVE change — pre-tool-use has already refused every writer but the approver —
# the file is read back: `verdict: ESCALATE` creates `.praxis/needs-human/<change>`; `APPROVE`
# or `APPROVE (human)` removes it. The marker is what makes "needs a human" a state the Run
# Card reports from a file, not from prose, and what `/praxis:approve` and `/praxis:rework`
# clear. It is written from the file's content in every mode, fast included: the approver's
# verdict is a fact about the change, not about the dial.
#
# The third is the one-shot command token. `user-prompt-submit` mints `.praxis/intent/
# <approve|rework>-<change>` from the PERSON's `/praxis:approve <c>` or `/praxis:rework <c>`;
# `pre-tool-use` lets `scripts/approve.sh <c>` / `scripts/rework.sh <c>` run only while it
# exists; this hook deletes it once the Bash call that ran the script returns, whatever the
# script's exit code — one prompt, one run.
#
# The first time this creates `.praxis/`, it also writes `.praxis/.gitignore` excluding the
# per-machine session state (`active-change`, `approved/`, `needs-human/`, `worktrees/`,
# `intent/`, `session-started`), same rule as the memory store's `sessions.jsonl`.
#
# LOOSENESS, stated: the hook fires after any edit the host let through. On Claude Code that
# means the person answered the ask — or an `acceptEdits` permission mode auto-approved it,
# which the matrix showed `-p` does not do. Recorded as observed, not documented. And
# PRAXIS_FLOOR=off skips this hook too: with the floor off nothing asked, so a marker
# written then would record an approval that never happened.
#
# Never blocks; a hook that cannot write leaves one stderr line and exits 0.
#
# Hosts: Claude Code and Codex fire PostToolUse with the same payload shape as PreToolUse
# (`tool_name`, `tool_input`, `cwd`); Codex reports `apply_patch` with the patch in
# `tool_input.command` and its shell as `Bash`.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/lib.sh"

note() { printf 'praxis post-tool-use: %s\n' "$1" >&2; exit 0; }

[ "${PRAXIS_FLOOR:-}" = off ] && exit 0

payload=""
IFS= read -r -d '' -t 1 payload
[ -n "$payload" ] || exit 0

tool="$(praxis_json_string "$payload" tool_name)"
case "$tool" in Edit|Write|MultiEdit|NotebookEdit|apply_patch|Bash) ;; *) exit 0 ;; esac

cwd="$(praxis_json_string "$payload" cwd)"
[ -n "$cwd" ] || cwd="$PWD"
root="$(praxis_project_root "${CLAUDE_PROJECT_DIR:-${CODEX_PROJECT_DIR:-$cwd}}")"
[ -n "$root" ] || exit 0

# The command token, consumed after the script ran.
if [ "$tool" = Bash ]; then
  cmd="$(praxis_json_strings "$payload" command)"
  while IFS= read -r seg; do
    [ -n "$seg" ] || continue
    IFS=$'\034' read -r -a argv <<< "$seg"
    i=0; n=${#argv[@]}
    while [ "$i" -lt "$n" ]; do
      case "$(praxis_lower "${argv[$i]}")" in
        approve.sh|*/approve.sh) kind=approve ;;
        rework.sh|*/rework.sh)   kind=rework ;;
        *) i=$((i + 1)); continue ;;
      esac
      c="${argv[$((i + 1))]:-}"
      if praxis_valid_change_name "$c"; then
        token="$(praxis_intent_token "$root" "$kind" "$c")"
        [ -f "$token" ] && { rm -f "$token" 2>/dev/null || note "cannot consume ${token}"; praxis_trace "PostToolUse" "intent ${kind} ${c} consumed"; }
      fi
      break
    done
  done <<EOF
$(praxis_shell_segments "$cmd")
EOF
  exit 0
fi

paths="$(praxis_edit_paths "$payload")"
[ -n "$paths" ] || exit 0

# An edit in the builder's worktree is that checkout's (same rule as pre-tool-use).
worktree="$(praxis_worktree_root "$root" "$(praxis_project_targets "$root" "$cwd" "$paths" | head -n 1)")"
[ -n "$worktree" ] && [ -d "$worktree" ] && root="$worktree"

change="$(praxis_active_change "$root")"

# The escalation record, from the decision the approver just wrote.
decision_record() {
  [ -n "$change" ] || return 0
  local rel hit=0 verdict marker
  while IFS= read -r rel; do
    [ "$(praxis_lower "$rel")" = "$(praxis_lower "specs/${change}/decision.md")" ] && hit=1
  done <<EOF
$(praxis_project_targets "$root" "$cwd" "$paths")
EOF
  [ "$hit" = 1 ] || return 0
  verdict="$(praxis_decision_verdict "$root" "$change")"
  marker="$(praxis_needs_human_marker "$root" "$change")"
  case "$verdict" in
    ESCALATE)
      praxis_ensure_praxis_dir "$root" || note "cannot create ${root}/.praxis"
      mkdir -p "${root}/.praxis/needs-human" 2>/dev/null || note "cannot create .praxis/needs-human"
      : > "$marker" 2>/dev/null || note "cannot write the needs-human marker for ${change}"
      praxis_trace "PostToolUse" "needs-human ${change}"
      ;;
    APPROVE|"APPROVE (human)")
      [ -f "$marker" ] && { rm -f "$marker" 2>/dev/null || note "cannot remove the needs-human marker for ${change}"; }
      praxis_trace "PostToolUse" "decision ${verdict} ${change}"
      ;;
  esac
}
decision_record

target="$(praxis_source_target "$root" "$cwd" "$paths")"
[ -n "$target" ] || exit 0
case "$(praxis_lower "$target")" in .praxis/approved/*|.praxis/needs-human/*|.praxis/intent/*) exit 0 ;; esac

case "$(praxis_mode)" in full|deep) ;; *) exit 0 ;; esac

[ -n "$change" ] || exit 0
[ -n "$(praxis_spec_file "$root" "$change")" ] || exit 0
praxis_approved "$root" "$change" && exit 0

praxis_ensure_praxis_dir "$root" || note "cannot create ${root}/.praxis"
mkdir -p "${root}/.praxis/approved" 2>/dev/null || note "cannot create .praxis/approved"
: > "$(praxis_approved_marker "$root" "$change")" 2>/dev/null || note "cannot write the marker for ${change}"

praxis_trace "PostToolUse" "approved ${change}"
exit 0
