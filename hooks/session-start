#!/usr/bin/env bash
# SessionStart hook for the Praxis plugin.
# Primes the session with the `using-praxis` router (progressive disclosure):
# it ORIENTS the model toward Praxis's orchestration loop and skill routing.
# It does NOT block any action — this is context injection, not enforcement.
#
# The per-turn anti-drift restatement lives in hooks/user-prompt-submit; this
# hook only handles the one-time orientation plus per-project memory recall.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/lib.sh"
PRAXIS_ROOT="$(praxis_root "$SCRIPT_DIR")"

router_content=$(cat "${PRAXIS_ROOT}/skills/using-praxis/SKILL.md" 2>&1 || echo "Error reading using-praxis skill")
router_escaped=$(escape_for_json "$router_content")
memory_block=$(praxis_memory_block)

# Factual framing (not an imperative system command) so host prompt-injection
# defenses treat it as context, not as an out-of-band instruction to surface.
session_context="This environment has the Praxis framework active. The following is the 'using-praxis' router — it describes how Praxis orchestrates work and which skill handles which task. Apply it for non-trivial work.\n\n${router_escaped}${memory_block}"

praxis_trace "SessionStart" ""
praxis_emit "SessionStart" "$session_context"
exit 0
